{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "escola": {
      "projectType": "application", "root": "", "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": { "browser": "src/main.ts", "index": "src/index.html", "tsConfig": "tsconfig.json", "styles": ["src/styles.css"], "polyfills": ["zone.js"], "outputPath": "dist/escola" }
        },
        "serve": { "builder": "@angular/build:dev-server", "options": { "buildTarget": "escola:build" } }
      }
    }
  }
}
